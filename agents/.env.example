# Copy to agents/.env (gitignored). Seeds are private: anyone with a seed can impersonate the agent.
# Generate with: python -c "import secrets;print(secrets.token_hex(24))"
AGENT_SEED=
RULES_AGENT_SEED=

# ParkSight Convex deployment HTTP URL (ends in .convex.site) and the shared secret set with
#   npx convex env set AGENT_SECRET <value>
CONVEX_SITE_URL=
AGENT_SECRET=

# Printed by `python -m agents.rules_agent` at startup. If unset or unreachable, the ParkSight Agent
# runs the same rules lookup in-process instead.
RULES_AGENT_ADDRESS=

# Optional: Apify + Elastic for the SFMTA rules text (python -m agents.seed_rules)
APIFY_TOKEN=
ELASTIC_KIBANA_URL=
ELASTIC_ES_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=parksight-rules
